# ============================================
# PintaReformas.es — .htaccess
# ============================================

Options -Indexes

# ---- 1. FORZAR HTTPS ----
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ---- 2. REDIRIGIR www → sin www ----
RewriteCond %{HTTP_HOST} ^www\.pintareformas\.es [NC]
RewriteRule ^(.*)$ https://pintareformas.es/$1 [R=301,L]

# ---- 2b. URLS VIEJAS DE LA MARCA ANTERIOR (por si llegan enlaces externos) ----
RewriteRule ^falsos-techos-pladur-led\.html$   /falsos-techos-led-granada.html [R=301,L]
RewriteRule ^pintura-pladur-granada\.html$     /pintura-y-placas-yeso-granada.html [R=301,L]
RewriteRule ^pintura-pladur-malaga\.html$      /pintura-y-placas-yeso-malaga.html [R=301,L]
RewriteRule ^pladur-cocinas\.html$             /placas-yeso-cocinas.html [R=301,L]
RewriteRule ^faq-schema-markup\.html$          /preguntas-pintor-granada.html [R=301,L]

# ---- 2c. RUTAS /blog/ ANTIGUAS → páginas reales en la raíz ----
RewriteRule ^blog/falsos-techos-led\.html$       /falsos-techos-led-granada.html [R=301,L]
RewriteRule ^blog/pintura-humedad-banos\.html$   /pintura-humedad-banos.html [R=301,L]
RewriteRule ^blog/costo-reforma-integral\.html$  /costo-reforma-integral.html [R=301,L]
RewriteRule ^blog/pladur-cocinas\.html$          /placas-yeso-cocinas.html [R=301,L]
RewriteRule ^blog(/.*)?$                          / [R=301,L]

# ---- 2c-bis. RUTAS EN INGLÉS QUE BUSCAN LOS AGENTES DE IA ----
# Las páginas existen con nombre en español. Los agentes (y algunos auditores)
# comprueban /about, /contact y /privacy antes de dar por buena una empresa.
RewriteRule ^about/?$    /sobre-nosotros.html [R=301,L]
RewriteRule ^contact/?$  /contacto.html       [R=301,L]
RewriteRule ^privacy/?$  /privacidad.html     [R=301,L]
RewriteRule ^legal/?$    /aviso-legal.html    [R=301,L]
# Versiones sin .html, por comodidad
RewriteRule ^contacto/?$        /contacto.html       [R=301,L]
RewriteRule ^sobre-nosotros/?$  /sobre-nosotros.html [R=301,L]
RewriteRule ^privacidad/?$      /privacidad.html     [R=301,L]

# ---- 2c-ter. RUTAS QUE SE TECLEAN A CIEGAS ----
# Un agente de IA probó /servicios el 06/09/2026 y se comió un 404. Estas rutas
# no existen como página pero son las que la gente (y los agentes) escriben.
RewriteRule ^servicios/?$   /servicios.html [R=301,L]
RewriteRule ^services/?$    /servicios.html [R=301,L]
RewriteRule ^portafolio/?$  /#portafolio [R=301,L]
RewriteRule ^trabajos/?$    /#portafolio [R=301,L]
RewriteRule ^precios/?$     /precio-pintar-piso-granada.html [R=301,L]
RewriteRule ^prices/?$      /precio-pintar-piso-granada.html [R=301,L]
RewriteRule ^tarifas/?$     /precio-pintar-piso-granada.html [R=301,L]
RewriteRule ^presupuesto/?$ /calculadora.html [R=301,L]
RewriteRule ^faq/?$         /preguntas-pintor-granada.html [R=301,L]
RewriteRule ^preguntas/?$   /preguntas-pintor-granada.html [R=301,L]

# ---- 2d. MARKDOWN PARA AGENTES DE IA ----
# Los .md viven en /md/ y se sirven por su propia URL (siempre disponible).
# Ademas se negocia por "Accept: text/markdown", PERO marcando esas respuestas
# como NO ALMACENABLES: el CDN de Hostinger ignora "Vary: Accept" y, si las
# cacheara, podria servir Markdown crudo a una persona con navegador.
# Con no-store no puede guardarlas ni repartirlas. Comprobado el 06/09/2026.
AddType 'text/markdown; charset=UTF-8' .md

<IfModule mod_rewrite.c>
    # Portada:  /  ->  /md/index.md
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{DOCUMENT_ROOT}/md/index.md -f
    RewriteRule ^$ /md/index.md [T=text/markdown,E=ES_MARKDOWN:1,L]

    # Directorios con indice:  /localidades/  ->  /md/localidades/index.md
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{DOCUMENT_ROOT}/md/$1/index.md -f
    RewriteRule ^(.+)/$ /md/$1/index.md [T=text/markdown,E=ES_MARKDOWN:1,L]

    # Paginas:  /pagina.html  ->  /md/pagina.md
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{DOCUMENT_ROOT}/md/$1.md -f
    RewriteRule ^(.+)\.html$ /md/$1.md [T=text/markdown,E=ES_MARKDOWN:1,L]
</IfModule>

<IfModule mod_headers.c>
    # Solo para la variante Markdown negociada: que nadie la cachee.
    Header always set Cache-Control "no-store, private" env=ES_MARKDOWN
    Header always set Vary "Accept, Accept-Encoding" env=ES_MARKDOWN
</IfModule>

# ---- 3. PÁGINA DE ERROR 404 ----
ErrorDocument 404 /404.html

# ---- 4. COMPRESIÓN GZIP ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE text/markdown
</IfModule>

# ---- 5. CACHÉ DE NAVEGADOR ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html  "access plus 1 day"
</IfModule>

# ---- 6. CABECERAS DE SEGURIDAD ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"

</IfModule>

# ---- 7. TIPOS MIME ----
AddType application/xml .xml
AddType image/webp .webp

# ---- 8. SERVIR WEBP AUTOMÁTICAMENTE ----
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_URI} ^/img/(.+)\.(jpe?g|png)$
  RewriteCond %{DOCUMENT_ROOT}/img/webp/%1.webp -f
  RewriteRule ^img/(.+)\.(jpe?g|png)$ /img/webp/$1.webp [T=image/webp,L]
</IfModule>
